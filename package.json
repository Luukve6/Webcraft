{
  "name": "webcraft",
  "version": "1.2.0",
  "description": "Webcraft: eigen, zelfstandig websitebeheer (/admin) voor statische websites met Cloudflare Access en KV-opslag.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs --mock",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "demo": "node scripts/make-demo.mjs",
    "check": "node scripts/lint.mjs && node --test \"tests/*.test.mjs\" && node scripts/build.mjs"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luukve6/webcraft.git"
  }
}
